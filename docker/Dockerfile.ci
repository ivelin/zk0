# Index digest for python:3.10-slim-bookworm (linux/amd64).
# Pin is the image index, not a moving tag.
FROM python:3.10-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1

WORKDIR /workspace

# Proven needed by Actions run 46032130167: lerobot 0.3.3 -> pynput -> evdev
# builds from source and needs linux/input.h plus a C compiler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libc6-dev \
        linux-libc-dev \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

# uv is how docker/Dockerfile.zk0 installs the ML stack; reuse it on the CPU CI image.
RUN pip install --no-cache-dir uv

# Same versions as production, CPU wheels instead of cu121.
RUN uv pip install --system --no-cache \
        torch==2.7.1 torchvision==0.22.1 \
        --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install --system --no-cache lerobot==0.3.3

CMD ["echo", "Container ready. Mount your app code to /workspace and run commands."]
