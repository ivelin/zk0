# Use the official LeRobot CPU base image for CI compatibility.
# That image currently ships huggingface_hub 1.33.x (download_bucket_files)
# and transformers 5.22.x. zk0's pyproject pin is transformers 4.51.x for
# production; CI reinstalls the image versions with --no-deps after
# `uv pip install -e '.[test]'` (see .github/workflows/ci.yml).
FROM huggingface/lerobot-cpu:latest

# Install OpenCV for video processing in LeRobot datasets

# Set environment variables for better Python behavior
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_LINK_MODE=copy

# Create a working directory for the application
# The app code will be mounted at runtime
WORKDIR /workspace

# Default command (can be overridden)
# The actual app code will be mounted at /workspace
CMD ["echo", "Container ready. Mount your app code to /workspace and run commands."]